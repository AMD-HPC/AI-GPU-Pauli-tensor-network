\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces Trotter time per layer at $\chi =50$, saturated layers only, expressed as ratios relative to the $3\times 3$ Householder time on each chip. All four columns share the same reference base within their chip, so cross-chip comparisons of absolute speed are avoided; only the within-chip scaling and Adap/HH ratio are claimed. ``no\_sat'' = $\chi _{\mathrm  {max}}^{\qopname  \relax m{min}} \neq  \chi _{\mathrm  {max}}^{\qopname  \relax m{max}}$, not all bonds reached $\chi =50$; ``---'' = run not collected. On MI100, Adap tracks HH closely (bandwidth-bound, algorithm invisible). On MI355X, the Adap column peels away from HH with growing grid size, reflecting the Cholesky compute advantage unlocked by HBM3E.\relax }}{34}{table.caption.52}\protected@file@percent }
\newlabel{tab:grid_scaling_mi355x}{{16}{34}{Trotter time per layer at $\chi =50$, saturated layers only, expressed as ratios relative to the $3\times 3$ Householder time on each chip. All four columns share the same reference base within their chip, so cross-chip comparisons of absolute speed are avoided; only the within-chip scaling and Adap/HH ratio are claimed. ``no\_sat'' = $\chimax ^{\min } \neq \chimax ^{\max }$, not all bonds reached $\chi =50$; ``---'' = run not collected. On MI100, Adap tracks HH closely (bandwidth-bound, algorithm invisible). On MI355X, the Adap column peels away from HH with growing grid size, reflecting the Cholesky compute advantage unlocked by HBM3E.\relax }{table.caption.52}{}}
