\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Lightcone saturation: grid size, geometric center, maximum Manhattan distance $d_{\mathrm  {max}}$ from center to corner, and minimum steps $n^*$ to reach the boundary. Runs with $n < n^*$ observe bulk scrambling only.\relax }}{19}{table.caption.25}\protected@file@percent }
\newlabel{tab:lightcone}{{4}{19}{Lightcone saturation: grid size, geometric center, maximum Manhattan distance $d_{\mathrm {max}}$ from center to corner, and minimum steps $n^*$ to reach the boundary. Runs with $n < n^*$ observe bulk scrambling only.\relax }{table.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Per-site non-identity Pauli weight $n(\mathbf  {r},t)$ on a $4\times 4$ grid, $\chi _{\qopname  \relax m{max}}=80$ (MI100), seven Trotter snapshots. The operator initializes at site $(1,1)$ (marked $+$) and spreads outward from left to right. The panel at $t=1.7$ carries a BP metastable trap (``trapped'' banner): $C(t)$ collapses to $0.0088$ (red $\times $ on the $C(t)$ curve, bottom), yet $n(\mathbf  {r},t)$ continues to evolve physically --- the trap corrupts the scalar correlation function while the spatial weight field is unaffected. The run recovers at $t=1.8$ ($C(t)$ returns to the converging sequence). Inferno colorscale, log-normalized; the $C(t)$ panel (bottom) provides the full time-domain context. \relax }}{20}{figure.caption.26}\protected@file@percent }
\newlabel{fig:lightcone_trap}{{4}{20}{Per-site non-identity Pauli weight $n(\mathbf {r},t)$ on a $4\times 4$ grid, $\chi _{\max }=80$ (MI100), seven Trotter snapshots. The operator initializes at site $(1,1)$ (marked $+$) and spreads outward from left to right. The panel at $t=1.7$ carries a BP metastable trap (``trapped'' banner): $C(t)$ collapses to $0.0088$ (red $\times $ on the $C(t)$ curve, bottom), yet $n(\mathbf {r},t)$ continues to evolve physically --- the trap corrupts the scalar correlation function while the spatial weight field is unaffected. The run recovers at $t=1.8$ ($C(t)$ returns to the converging sequence). Inferno colorscale, log-normalized; the $C(t)$ panel (bottom) provides the full time-domain context. \relax }{figure.caption.26}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces $C(t)$ at selected Trotter layers for $n\times n$ grids, $\chi =50$, MI100. All grids share the same $C(t)$ for $t \leq 0.9$ to 4 significant figures (early-time universality). Divergence begins when the operator front reaches the lattice boundary, consistent with the lightcone bound $n^*$ in Table\nobreakspace  {}\ref  {tab:lightcone}. \relax }}{20}{table.caption.29}\protected@file@percent }
\newlabel{tab:ct_grids}{{5}{20}{$\Ct $ at selected Trotter layers for $n\times n$ grids, $\chi =50$, MI100. All grids share the same $\Ct $ for $t \leq 0.9$ to 4 significant figures (early-time universality). Divergence begins when the operator front reaches the lattice boundary, consistent with the lightcone bound $n^*$ in Table~\ref {tab:lightcone}. \relax }{table.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Same layout as Figure\nobreakspace  {}\ref  {fig:lightcone_trap} for the clean baseline run at $\chi _{\qopname  \relax m{max}}=40$ (no BP trap). $C(t)$ decays monotonically from $1$ to $\approx 0.057$ at $t=2.0$. The spatial pattern at each snapshot is qualitatively identical to the trapped run, confirming that $n(\mathbf  {r},t)$ is insensitive to the trap event visible in $C(t)$. \relax }}{21}{figure.caption.27}\protected@file@percent }
\newlabel{fig:lightcone_clean}{{5}{21}{Same layout as Figure~\ref {fig:lightcone_trap} for the clean baseline run at $\chi _{\max }=40$ (no BP trap). $C(t)$ decays monotonically from $1$ to $\approx 0.057$ at $t=2.0$. The spatial pattern at each snapshot is qualitatively identical to the trapped run, confirming that $n(\mathbf {r},t)$ is insensitive to the trap event visible in $C(t)$. \relax }{figure.caption.27}{}}
\@writefile{toc}{\contentsline {paragraph}{Spatial $\chi $-convergence: the difference field $\Delta n(\mathbf  {r},t)$.}{21}{section*.30}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Symmetric initial condition and BP stability.}{21}{section*.33}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces $n(\mathbf  {r},t)$ on a $9\times 9$ grid, $\chi _{\qopname  \relax m{max}}=20$ (MI100, correct center $(4,4)$), seven snapshots from $t=0.1$ to $t=2.0$. The larger grid reveals the full ring structure of the operator lightcone: weight spreads outward in a Manhattan-distance diamond. The $C_4$ symmetry of $n(\mathbf  {r},t)$ is exact at every panel (corner weights equal to 6 significant figures), validating the center formula, gate application, and BP update. $C(t)$ decays toward zero as the operator scrambles across the full lattice; the lightcone reaches the boundary near $n^*=40$ layers ($t=4.0$), consistent with Table\nobreakspace  {}\ref  {tab:lightcone}. \relax }}{22}{figure.caption.28}\protected@file@percent }
\newlabel{fig:lightcone_9x9}{{6}{22}{$n(\mathbf {r},t)$ on a $9\times 9$ grid, $\chi _{\max }=20$ (MI100, correct center $(4,4)$), seven snapshots from $t=0.1$ to $t=2.0$. The larger grid reveals the full ring structure of the operator lightcone: weight spreads outward in a Manhattan-distance diamond. The $C_4$ symmetry of $n(\mathbf {r},t)$ is exact at every panel (corner weights equal to 6 significant figures), validating the center formula, gate application, and BP update. $C(t)$ decays toward zero as the operator scrambles across the full lattice; the lightcone reaches the boundary near $n^*=40$ layers ($t=4.0$), consistent with Table~\ref {tab:lightcone}. \relax }{figure.caption.28}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.5}Finite-Size Scaling and Bethe Approximation Stability}{22}{subsection.6.5}\protected@file@percent }
\newlabel{sec:finite_size}{{6.5}{22}{Finite-Size Scaling and Bethe Approximation Stability}{subsection.6.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Spatial $\chi $-convergence on $4\times 4$: $\Delta n(\mathbf  {r},t) = n_{\chi =80} - n_{\chi =40}$ at six snapshots. Row\nobreakspace  {}1 ($\chi =80$, BP trap): $n(\mathbf  {r},t)$ on inferno log scale. Row\nobreakspace  {}2 ($\chi =40$, clean): same scale. Row\nobreakspace  {}3 ($\Delta n$): diverging colorscale, blue $\to $ black (zero) $\to $ red. The difference accumulates monotonically ($\qopname  \relax m{max}|\Delta n|$ grows from $0$ at early times to $0.0027$ at $t=2.0$), reflecting cumulative truncation differences. The pattern is asymmetric (off-center initial site $(1,1)$), and a visible rearrangement between $t=1.7$ (trapped, red $\times $) and $t=1.8$ (recovered) provides a spatial fingerprint of the BP metastable trap. Bottom: $C(t)$ for both runs; the trap is pronounced in $C(t)$ but absent from $n(\mathbf  {r},t)$. \relax }}{23}{figure.caption.31}\protected@file@percent }
\newlabel{fig:diff_4x4}{{7}{23}{Spatial $\chi $-convergence on $4\times 4$: $\Delta n(\mathbf {r},t) = n_{\chi =80} - n_{\chi =40}$ at six snapshots. Row~1 ($\chi =80$, BP trap): $n(\mathbf {r},t)$ on inferno log scale. Row~2 ($\chi =40$, clean): same scale. Row~3 ($\Delta n$): diverging colorscale, blue $\to $ black (zero) $\to $ red. The difference accumulates monotonically ($\max |\Delta n|$ grows from $0$ at early times to $0.0027$ at $t=2.0$), reflecting cumulative truncation differences. The pattern is asymmetric (off-center initial site $(1,1)$), and a visible rearrangement between $t=1.7$ (trapped, red $\times $) and $t=1.8$ (recovered) provides a spatial fingerprint of the BP metastable trap. Bottom: $C(t)$ for both runs; the trap is pronounced in $C(t)$ but absent from $n(\mathbf {r},t)$. \relax }{figure.caption.31}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.6}Cross-Architecture Portability: Physics Comparison}{23}{subsection.6.6}\protected@file@percent }
\newlabel{sec:portability_physics}{{6.6}{23}{Cross-Architecture Portability: Physics Comparison}{subsection.6.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Spatial $\chi $-convergence on $5\times 5$ (symmetric control): $\Delta n(\mathbf  {r},t) = n_{\chi =80} - n_{\chi =50}$ at six snapshots. Same layout as Figure\nobreakspace  {}\ref  {fig:diff_4x4}. The symmetric center $(2,2)$ imposes exact $C_4$ symmetry on $\Delta n$ at every panel (red interior ring, blue corners at late times), with no anomalous step at any layer. This confirms that the monotone $\qopname  \relax m{max}|\Delta n|$ growth on a symmetric grid is a pure bond-dimension effect, uncontaminated by the BP fixed-point multiplicity that distorts the $4\times 4$ pattern. The pair of figures (Figs.\nobreakspace  {}\ref  {fig:diff_4x4}--\ref  {fig:diff_5x5}) thus decomposes $\chi $-convergence of the spatial weights into a symmetric bulk contribution and an asymmetry-driven trap contribution. \relax }}{24}{figure.caption.32}\protected@file@percent }
\newlabel{fig:diff_5x5}{{8}{24}{Spatial $\chi $-convergence on $5\times 5$ (symmetric control): $\Delta n(\mathbf {r},t) = n_{\chi =80} - n_{\chi =50}$ at six snapshots. Same layout as Figure~\ref {fig:diff_4x4}. The symmetric center $(2,2)$ imposes exact $C_4$ symmetry on $\Delta n$ at every panel (red interior ring, blue corners at late times), with no anomalous step at any layer. This confirms that the monotone $\max |\Delta n|$ growth on a symmetric grid is a pure bond-dimension effect, uncontaminated by the BP fixed-point multiplicity that distorts the $4\times 4$ pattern. The pair of figures (Figs.~\ref {fig:diff_4x4}--\ref {fig:diff_5x5}) thus decomposes $\chi $-convergence of the spatial weights into a symmetric bulk contribution and an asymmetry-driven trap contribution. \relax }{figure.caption.32}{}}
