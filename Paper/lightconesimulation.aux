\@writefile{toc}{\contentsline {subsection}{\numberline {6.7}Grid Scaling (Timing)}{26}{subsection.6.7}\protected@file@percent }
\newlabel{sec:grid_timing}{{6.7}{26}{Grid Scaling (Timing)}{subsection.6.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \small  Grid scaling at $\chi =50$: Trotter time per layer (average over all layers) for square grids on MI100 and MI60, both QR modes. \emph  {Top}: raw times in ms; bonds $= 2N(N-1)$ for an $N\times N$ grid; MI60/MI100 ratio computed from Householder columns. \emph  {Bottom}: same data plotted vs.\ bond count. Solid lines ($\circ $): Householder QR; dashed lines ($\square $): Adaptive QR; blue: MI100; red: MI60; dotted: linear fits through the origin (slopes annotated in s/bond). Both MI100 modes scale linearly with bond count, confirming that gate cost depends only on $\chi $ and site degree, not grid size. Adaptive is 10--20\% faster on MI100 because Cholesky avoids the full Householder factorization when the Gram matrix is well-conditioned. MI60 is approximately $5\times $ slower than MI100 across all grid sizes, consistent with the MFMA vs.\ vector-FP throughput ratio at $\chi =50$.}}{26}{figure.caption.40}\protected@file@percent }
\newlabel{tab:grid_scaling}{{9}{26}{\small Grid scaling at $\chi =50$: Trotter time per layer (average over all layers) for square grids on MI100 and MI60, both QR modes. \emph {Top}: raw times in ms; bonds $= 2N(N-1)$ for an $N\times N$ grid; MI60/MI100 ratio computed from Householder columns. \emph {Bottom}: same data plotted vs.\ bond count. Solid lines ($\circ $): Householder QR; dashed lines ($\square $): Adaptive QR; blue: MI100; red: MI60; dotted: linear fits through the origin (slopes annotated in s/bond). Both MI100 modes scale linearly with bond count, confirming that gate cost depends only on $\chi $ and site degree, not grid size. Adaptive is 10--20\% faster on MI100 because Cholesky avoids the full Householder factorization when the Gram matrix is well-conditioned. MI60 is approximately $5\times $ slower than MI100 across all grid sizes, consistent with the MFMA vs.\ vector-FP throughput ratio at $\chi =50$}{figure.caption.40}{}}
\newlabel{fig:grid_scaling}{{9}{26}{\small Grid scaling at $\chi =50$: Trotter time per layer (average over all layers) for square grids on MI100 and MI60, both QR modes. \emph {Top}: raw times in ms; bonds $= 2N(N-1)$ for an $N\times N$ grid; MI60/MI100 ratio computed from Householder columns. \emph {Bottom}: same data plotted vs.\ bond count. Solid lines ($\circ $): Householder QR; dashed lines ($\square $): Adaptive QR; blue: MI100; red: MI60; dotted: linear fits through the origin (slopes annotated in s/bond). Both MI100 modes scale linearly with bond count, confirming that gate cost depends only on $\chi $ and site degree, not grid size. Adaptive is 10--20\% faster on MI100 because Cholesky avoids the full Householder factorization when the Gram matrix is well-conditioned. MI60 is approximately $5\times $ slower than MI100 across all grid sizes, consistent with the MFMA vs.\ vector-FP throughput ratio at $\chi =50$}{figure.caption.40}{}}
