\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Per-layer Trotter and BP time on the $10\times 10$ lattice at $\chi _{\mathrm  {max}}=100$, MI355X only (HBM3E, 309\,GB). This run requires $\approx 109$\,GB and is not feasible on MI100 or MI60; MI355X is the enabling hardware. Solid line: Householder QR; dashed: Adaptive QR. Trotter time (top) grows smoothly as bond dimension saturates then climbs with increasing BP sweep count. BP time (bottom) is variable because convergence at $\chi =100$ requires up to 100 sweeps (the configured maximum); the spread reflects per-layer variation in BP fixed-point difficulty. Runs completed 40 of 100 requested layers within the 16\,h wall-time allocation.\relax }}{38}{figure.caption.55}\protected@file@percent }
\newlabel{fig:mi355x_10x10_chi100}{{11}{38}{Per-layer Trotter and BP time on the $10\times 10$ lattice at $\chimax =100$, MI355X only (HBM3E, 309\,GB). This run requires $\approx 109$\,GB and is not feasible on MI100 or MI60; MI355X is the enabling hardware. Solid line: Householder QR; dashed: Adaptive QR. Trotter time (top) grows smoothly as bond dimension saturates then climbs with increasing BP sweep count. BP time (bottom) is variable because convergence at $\chi =100$ requires up to 100 sweeps (the configured maximum); the spread reflects per-layer variation in BP fixed-point difficulty. Runs completed 40 of 100 requested layers within the 16\,h wall-time allocation.\relax }{figure.caption.55}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Operator weight $n(\mathbf  {r},t)$ on the $10\times 10$ lattice at $\chi _{\mathrm  {max}}=100$, Householder QR, eight Trotter snapshots (two rows of four, $\delta t = 0.1$). The operator starts as a single-site excitation at the center $(4,4)$ and expands as a Manhattan-distance diamond (Lieb-Robinson cone). At $t \approx 2.0$--$2.4$ the expanding front reaches the lattice boundary and reflects, forming a bright ring of accumulated weight at sites equidistant from the center. At later times the ring disperses toward increasingly uniform coverage ($S_{\rm  frac} \to 1$). \emph  {Lower panel}: $C(t)$ decays below $10^{-3}$ by $t \approx 2.0$; all physical information at late times is carried by $n(\mathbf  {r},t)$, not by $C(t)$. This run requires $\approx 109$\,GB and is only feasible on MI355X.\relax }}{39}{figure.caption.57}\protected@file@percent }
\newlabel{fig:lightcone_10x10}{{12}{39}{Operator weight $n(\mathbf {r},t)$ on the $10\times 10$ lattice at $\chimax =100$, Householder QR, eight Trotter snapshots (two rows of four, $\delta t = 0.1$). The operator starts as a single-site excitation at the center $(4,4)$ and expands as a Manhattan-distance diamond (Lieb-Robinson cone). At $t \approx 2.0$--$2.4$ the expanding front reaches the lattice boundary and reflects, forming a bright ring of accumulated weight at sites equidistant from the center. At later times the ring disperses toward increasingly uniform coverage ($S_{\rm frac} \to 1$). \emph {Lower panel}: $C(t)$ decays below $10^{-3}$ by $t \approx 2.0$; all physical information at late times is carried by $n(\mathbf {r},t)$, not by $C(t)$. This run requires $\approx 109$\,GB and is only feasible on MI355X.\relax }{figure.caption.57}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Operator weight $n(\mathbf  {r},t)$ on the $11\times 11$ lattice at $\chi _{\mathrm  {max}}=100$, Householder QR, eight Trotter snapshots (two rows of four). The operator starts as a single-site excitation at the center $(5,5)$. \textbf  {Early phase} ($t \lesssim 0.7$): the weight expands as a Manhattan-distance diamond consistent with a Lieb-Robinson velocity $v_{\rm  LR}\approx 1$--$2$ lattice sites per unit time. \textbf  {Boundary reflection} ($t \approx 1.7$--$2.5$): the expanding front reaches all four edges and reflected waves interfere constructively, forming a bright ring of accumulated weight at the sites equidistant from the center. \textbf  {Scrambling} ($t \gtrsim 2.5$): the ring disperses and weight approaches uniform coverage ($S_{\rm  frac}\to 1$). The C4 lattice symmetry is visible throughout --- the pattern remains fourfold-symmetric at every layer, confirming zero BP trap contamination. $C(t)$ (lower panel) decays smoothly to ${\approx }0.03$ over 33 layers; the full 70-layer run will extend the curve to the fully scrambled regime. This run requires $\approx 130$\,GB and is only feasible on MI355X.\relax }}{40}{figure.caption.59}\protected@file@percent }
\newlabel{fig:lightcone_11x11_chi100}{{13}{40}{Operator weight $n(\mathbf {r},t)$ on the $11\times 11$ lattice at $\chimax =100$, Householder QR, eight Trotter snapshots (two rows of four). The operator starts as a single-site excitation at the center $(5,5)$. \textbf {Early phase} ($t \lesssim 0.7$): the weight expands as a Manhattan-distance diamond consistent with a Lieb-Robinson velocity $v_{\rm LR}\approx 1$--$2$ lattice sites per unit time. \textbf {Boundary reflection} ($t \approx 1.7$--$2.5$): the expanding front reaches all four edges and reflected waves interfere constructively, forming a bright ring of accumulated weight at the sites equidistant from the center. \textbf {Scrambling} ($t \gtrsim 2.5$): the ring disperses and weight approaches uniform coverage ($S_{\rm frac}\to 1$). The C4 lattice symmetry is visible throughout --- the pattern remains fourfold-symmetric at every layer, confirming zero BP trap contamination. $C(t)$ (lower panel) decays smoothly to ${\approx }0.03$ over 33 layers; the full 70-layer run will extend the curve to the fully scrambled regime. This run requires $\approx 130$\,GB and is only feasible on MI355X.\relax }{figure.caption.59}{}}
