\section{Mathematical Formulation}
\label{sec:physics}
% ══════════════════════════════════════════════════════════════════════════════

This section establishes the physical model and the mathematical framework
underlying the simulation. We work entirely in the Heisenberg picture, where
the observable rather than the quantum state is evolved in time, and we
represent it as a tensor network on the lattice graph.

\subsection{Model}

We consider the 2D transverse-field Ising model~\citep{sachdev2011quantum} on a
$k \times l$ rectangular lattice with open boundary conditions:
\begin{equation}
  \ham = -J \sum_{\langle ij \rangle} X_i X_j \;-\; h \sum_i Z_i,
  \label{eq:hamiltonian}
\end{equation}
where $X_i, Z_i$ are Pauli operators on site $i$, $J$ is the Ising coupling,
$h$ is the transverse field strength, and the sum is over nearest-neighbor pairs.

\subsection{Heisenberg Picture and Spin Autocorrelation}

At infinite temperature ($\rho_0 = \mathbf{I}/2^N$), the spin autocorrelation
function at the lattice center site $c$ simplifies to:
\begin{equation}
  C(t) = \frac{1}{2^N} \mathrm{Tr}\bigl[ Z_c(t)\, Z_c \bigr],
  \label{eq:autocorr}
\end{equation}
where $Z_c(t) = e^{i\ham t}\, Z_c\, e^{-i\ham t}$ is the Heisenberg-evolved
center observable.

\subsection{Pauli Basis Tensor Network}

The operator $Z_c(t)$ is expanded in the $D=4$ Pauli basis $\{I, X, Y, Z\}$ at
each site. The initial condition is $Z_c(0) = Z$ at the center, $I$ elsewhere.
The resulting state is a tensor network on the lattice graph with:
\begin{itemize}
  \item one rank-$(\deg(v)+1)$ tensor $\psi_v$ per site $v$, with indices
        $(\text{bond}_1, \ldots, \text{bond}_{\deg(v)}, \text{Pauli})$;
  \item one $\chi \times \chi$ message matrix $\mu_{a \to b}$ per directed bond
        $(a \to b)$ in the Vidal canonical gauge~\citep{vidal2004efficient}.
\end{itemize}

\subsection{Trotter Decomposition}

Each time step $\delta t$ applies a first-order Trotter layer~\citep{suzuki1976generalized}:
\begin{equation}
  U(\delta t) = R_z(h\,\delta t) \cdot R_{xx}(2J\,\delta t) \cdot R_z(h\,\delta t),
  \label{eq:trotter}
\end{equation}
where $R_z$ is a single-site rotation (diagonal in the Pauli basis) and $R_{xx}$
is a two-site entangling gate applied to all nearest-neighbor pairs via a
4-color decomposition: bonds are partitioned into four color classes such that no
two bonds in the same class share a site, enabling sequential independent updates.

\subsection{Gate Update}
\label{sec:gate_update}

For each two-site gate on bond $(v_1, v_2)$, the update proceeds as follows
(see Algorithm~\ref{alg:gate}):
\begin{enumerate}
  \item Absorb $\sqrt{\mu}$ (BP message) into each site tensor (environment gauging).
  \item QR-decompose each gauged tensor: $\mathbf{cv}_i = \mathbf{Q}_i \mathbf{R}_i$.
  \item Form the bond matrix $\mathbf{RR} = \mathbf{R}_1^\top \mathbf{R}_2$.
  \item Apply the gate $G \in \mathbb{R}^{D^2 \times D^2}$ to $\mathbf{RR}$:
        $\tilde{\mathbf{R}} = G(\mathbf{RR})$.
  \item SVD of $\tilde{\mathbf{R}}$: $\mathbf{U}\mathbf{S}\mathbf{V}^\top$,
        truncated to rank $\chimax$.
  \item Reconstruct: $\mathbf{cv}_i^{\text{new}} = \mathbf{Q}_i \mathbf{M}_i$
        where $\mathbf{M}_i$ encodes $\mathbf{U}/\mathbf{V}^\top$ scaled by
        $\sqrt{\mathbf{S}}$.
  \item Deabsorb $(\sqrt{\mu})^{-1}$.
  \item Store $\lambda_i \leftarrow s_i / \|\mathbf{s}\|_2$ (Vidal normalization,
        $\sum_i \lambda_i^2 = 1$).
\end{enumerate}

\subsection{Correlation Function via Belief Propagation}

The autocorrelation~\eqref{eq:autocorr} is evaluated via BP on the Bethe lattice:
\begin{equation}
  C(t) = \exp\!\Bigl(\sum_v \log|vs_v| \;-\; \sum_e \log|Z_e|\Bigr)
         \times \mathrm{sign\_num} \times \mathrm{sign\_den},
  \label{eq:bethe}
\end{equation}
where $vs_v$ is the scalar contraction of $\psi_v$ with the observable (Z at
center $c$, I elsewhere), and
\begin{equation}
  Z_e = \sum_i \mu_{a \to b}[i]\, \mu_{b \to a}[i]
  \label{eq:ze}
\end{equation}
is the Bethe edge correction that removes double-counting after BP normalization.
The sign factors $\mathrm{sign\_num} = \prod_v \mathrm{sign}(vs_v)$ and
$\mathrm{sign\_den} = \prod_e \mathrm{sign}(Z_e)$ are tracked explicitly:
since BP messages on a $Z$-observable network can have negative elements,
$Z_e$ can be negative, and omitting the sign correction causes catastrophic
errors at late times.

