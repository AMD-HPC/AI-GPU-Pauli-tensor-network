\section{Algorithms}
\label{sec:algorithms}
% ══════════════════════════════════════════════════════════════════════════════

Four algorithmic components dominate both correctness and performance: a GPU-native
tensor permutation that eliminates PCIe traffic, an adaptive QR strategy that
exploits the tall-thin structure of the gauged tensors, a truncated SVD on the
bond matrix, and a BP message update with log-space Bethe partition function
evaluation. We describe each in turn.

\subsection{GPU Tensor Permutation}
\label{sec:permute}

Site tensors are stored in canonical direction order
$[\text{UP}, \text{DOWN}, \text{LEFT}, \text{RIGHT}, \text{Pauli}]$.
The QR decomposition requires the cut-bond index in the penultimate position.
Permuting a rank-5 tensor of $\chimax^4 D$ elements on the CPU requires:
D2H transfer ($\sim$100\,MB per interior site at $\chi=50$), an index-remapping
loop, and H2D transfer back — totaling $\sim$9.6\,GB of PCIe traffic per Trotter
layer at $\chi=50$.

Our custom HIP kernel eliminates all PCIe traffic. Each thread handles one output
element by decomposing the input flat index (column-major) into a multi-index,
applying the permutation, and computing the output flat index:

\begin{lstlisting}[language=C++, caption={GPU tensor permutation kernel}]
__global__ void tensor_permute_kernel(
    const float* __restrict__ src,
    float* __restrict__ dst,
    PermuteMeta meta, int total)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total) return;
    int in_idx = idx, out_idx = 0;
    for (int d = 0; d < meta.ndim; d++) {
        int coord = in_idx % meta.shape_in[d];
        in_idx   /= meta.shape_in[d];
        out_idx  += coord * meta.stride_out[d];
    }
    dst[out_idx] = src[idx];
}
\end{lstlisting}

The \texttt{PermuteMeta} struct (shape, output strides, permutation, rank) is
passed by value to avoid a device pointer indirection. This kernel reduced trotter
time from $\sim$49{,}000\,ms/layer to $\sim$6{,}400\,ms/layer at $\chi=50$
saturation — a \textbf{7.6$\times$ speedup} from this single change.

\subsection{Adaptive QR Decomposition}
\label{sec:qr}

At each gate application, a QR decomposition of the gauged tensor
$\mathbf{cv} \in \mathbb{R}^{m \times n}$ is required, where
$m = \chimax^3$ and $n = D\chimax$ at saturation. Two paths are used:

\paragraph{Cholesky-QR~\citep{golub2013matrix}} (when $n > 150$ and $m/n > 150$):
\begin{equation}
  \mathbf{C} = \mathbf{cv}^\top \mathbf{cv} + \epsilon \mathbf{I}, \quad
  \mathbf{R} = \mathrm{chol}(\mathbf{C}), \quad
  \mathbf{Q} = \mathbf{cv}\, \mathbf{R}^{-1},
  \label{eq:cholqr}
\end{equation}
with $\epsilon = 10^{-8}$ ensuring positive definiteness. This path uses
rocBLAS \texttt{SGEMM} for $\mathbf{C}$ and \texttt{Q}, and rocSOLVER
\texttt{SPOTRF} for the Cholesky factor. The host-side back-substitution for
$\mathbf{R}^{-1}$ involves a matrix of size at most $(D\chimax)^2 \leq 400^2$
and is negligible.

\paragraph{Householder-QR} (fallback for small $n$ or Cholesky failure):
\[
  (\mathbf{Q}, \mathbf{R}) = \mathrm{qr}(\mathbf{cv}),
\]
via rocSOLVER \texttt{SGEQRF} + \texttt{SORGQR}. This path is backward stable
but involves a D2H copy of the full $m \times n$ matrix, which is prohibitive
at saturation chi. It is used only at early layers when $n \leq 150$.

\paragraph{SVD and Truncation.}
The bond matrix $\mathbf{RR} \in \mathbb{R}^{k_{1D} \times k_{2D}}$ is factored
via rocSOLVER \texttt{SGESVD}. The truncation rank is:
\begin{equation}
  \chi_{\text{new}} = \min\!\bigl(\#\{i : s_i \geq \epsilon_{\text{cut}}\, s_0\},\;
                                   \chimax\bigr),
  \label{eq:truncation}
\end{equation}
with default cutoff $\epsilon_{\text{cut}} = 10^{-11}$.
Singular values are Vidal-normalized before storage:
\begin{equation}
  \lambda_i = s_i \,/\, \bigl(\textstyle\sum_j s_j^2\bigr)^{1/2},
  \qquad \sum_i \lambda_i^2 = 1.
  \label{eq:vidal_norm}
\end{equation}
This keeps all message entries in $[0,1]$ and prevents float32 overflow at
$\chi \geq 50$ saturation.

\paragraph{BP Message Update.}
Each BP sweep updates all messages via:
\begin{equation}
  \mu_{v \to e}^{\text{new}}[i] \propto
    \psi_v[i, \ldots] \cdot \prod_{e' \neq e} \mu_{e' \to v}[i],
  \label{eq:bp}
\end{equation}
implemented via rocBLAS strided-batched \texttt{SGEMV}. Normalization transfers
only $\chi$ scalars ($\leq 400$ bytes) per message via D2H.

Adaptive convergence: the sweep loop exits when
\begin{equation}
  \max_i |\mu^{\text{new}}[i,i] - \mu^{\text{old}}[i,i]| < \tau = 10^{-5},
  \label{eq:bp_tol}
\end{equation}
returning the sweep count. Most layers converge in 3--20 sweeps; hard layers
(typically alternating layers at late times) require the full 100-sweep budget.

\begin{algorithm}
\caption{Gate update for bond $(v_1, v_2)$}
\label{alg:gate}
\begin{algorithmic}[1]
\Require Site tensors $\psi_{v_1}, \psi_{v_2}$, gate $G$, messages $\mu$, $\chimax$
\Ensure Updated $\psi_{v_1}, \psi_{v_2}$, updated message $\mu_{v_1 \leftrightarrow v_2}$
\State Compute $\sqrt{\mu}$, $(\sqrt{\mu})^{-1}$ via \textsc{Syevd} for each env bond
\State $\mathbf{cv}_i \leftarrow \textsc{AbsorbEnv}(\psi_{v_i},\, \sqrt{\mu})$
       \quad $i = 1, 2$
\State $\mathbf{cv}_i \leftarrow \textsc{PermuteCutToLast}(\mathbf{cv}_i)$
\State $[\mathbf{Q}_i, \mathbf{R}_i] \leftarrow \textsc{AdaptiveQR}(\mathbf{cv}_i)$
\State $\mathbf{RR} \leftarrow \mathbf{R}_1^\top \mathbf{R}_2$
       \quad (via \textsc{Sgemm})
\State $\tilde{\mathbf{R}} \leftarrow G(\mathbf{RR})$
       \quad (host loop over $D^4$ entries)
\State $[\mathbf{U}, \mathbf{s}, \mathbf{V}^\top] \leftarrow \textsc{Sgesvd}(\tilde{\mathbf{R}})$
\State $\chi_{\text{new}} \leftarrow \min(\#\{s_i \geq \epsilon_{\text{cut}} s_0\},\, \chimax)$
\State $\mathbf{cv}_i^{\text{new}} \leftarrow \mathbf{Q}_i \mathbf{M}_i$
       \quad (bridge matrix $\mathbf{M}_i$ from $\mathbf{U}/\mathbf{V}^\top$, $\sqrt{\mathbf{s}}$)
\State $\mathbf{cv}_i^{\text{new}} \leftarrow \textsc{InversePermuteCut}(\mathbf{cv}_i^{\text{new}})$
\State $\mathbf{cv}_i^{\text{new}} \leftarrow \textsc{DeabsorbEnv}(\mathbf{cv}_i^{\text{new}},\,
       (\sqrt{\mu})^{-1})$
\State $\psi_{v_i} \leftarrow \mathbf{cv}_i^{\text{new}}$
\State $\mu_{v_1 \to v_2} \leftarrow \mu_{v_2 \to v_1}
       \leftarrow \mathrm{diag}(\lambda)$,
       \quad $\lambda_i = s_i/\|\mathbf{s}\|_2$
\end{algorithmic}
\end{algorithm}

