\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Predicted peak VRAM (GB) for $n\times n$ grids at selected bond dimensions, from the analytic model (\S  \ref {sec:memory_model}). $\bullet $~fits on MI100/MI60 ($\leq 32$\,GB); $\circ $~fits on MI350/MI250X but exceeds MI100; MI300X (192\,GB) covers all entries.}}{21}{figure.caption.20}\protected@file@percent }
\newlabel{tab:vram_grid}{{7}{21}{Predicted peak VRAM (GB) for $n\times n$ grids at selected bond dimensions, from the analytic model (\S \ref {sec:memory_model}). $\bullet $~fits on MI100/MI60 ($\leq 32$\,GB); $\circ $~fits on MI350/MI250X but exceeds MI100; MI300X (192\,GB) covers all entries}{figure.caption.20}{}}
