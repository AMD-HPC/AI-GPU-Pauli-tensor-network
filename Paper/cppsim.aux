\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Spin autocorrelation $C(t)$ on $4\times 4$ grid (MI100) for $\chi \in \{50, 70, 80, 100\}$, with Julia float64 reference at $\chi =50$. Agreement across all columns at early times confirms correctness; divergence at late times reveals truncation error.}}{12}{table.caption.11}\protected@file@percent }
\newlabel{tab:ct}{{2}{12}{Spin autocorrelation $C(t)$ on $4\times 4$ grid (MI100) for $\chi \in \{50, 70, 80, 100\}$, with Julia float64 reference at $\chi =50$. Agreement across all columns at early times confirms correctness; divergence at late times reveals truncation error}{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Spin autocorrelation $C(t)$ on a $4\times 4$ grid (log scale) for $\chi \in \{50, 70, 80, 100, 120\}$ on MI100 (red), $\chi =100$ on MI60 (blue), and the Julia float64 reference at $\chi =50$ (black dashed, 30 layers). All curves overlap to within float32 rounding for $t \leq 1.5$, confirming correctness across GPU generations. The log scale reveals two distinct dynamical regimes separated by a kink at $t \approx 0.5$: a fast initial decay driven by nearest-neighbor gate spreading, followed by a slower plateau as entanglement saturates the bond dimension. Truncation artifacts appear as sharp downward spikes: $\chi =50$ at $t=2.0$ and a BP convergence anomaly at $\chi =100$, $t=1.9$ (see \S  \ref {sec:bp_convergence}). The Julia reference exhibits its own truncation at $t \approx 2.9$ — the same physical mechanism at the same $\chi =50$, delayed by float64 precision.}}{13}{figure.caption.12}\protected@file@percent }
\newlabel{fig:ct}{{2}{13}{Spin autocorrelation $C(t)$ on a $4\times 4$ grid (log scale) for $\chi \in \{50, 70, 80, 100, 120\}$ on MI100 (red), $\chi =100$ on MI60 (blue), and the Julia float64 reference at $\chi =50$ (black dashed, 30 layers). All curves overlap to within float32 rounding for $t \leq 1.5$, confirming correctness across GPU generations. The log scale reveals two distinct dynamical regimes separated by a kink at $t \approx 0.5$: a fast initial decay driven by nearest-neighbor gate spreading, followed by a slower plateau as entanglement saturates the bond dimension. Truncation artifacts appear as sharp downward spikes: $\chi =50$ at $t=2.0$ and a BP convergence anomaly at $\chi =100$, $t=1.9$ (see \S \ref {sec:bp_convergence}). The Julia reference exhibits its own truncation at $t \approx 2.9$ — the same physical mechanism at the same $\chi =50$, delayed by float64 precision}{figure.caption.12}{}}
