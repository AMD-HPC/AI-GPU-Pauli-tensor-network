\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Trotter time per layer at saturation ($\chi =50$) for square grids on MI100. Time scales linearly with the number of bonds $n_{\text  {bonds}}$.}}{20}{figure.caption.19}\protected@file@percent }
\newlabel{tab:grid_scaling}{{4}{20}{Trotter time per layer at saturation ($\chi =50$) for square grids on MI100. Time scales linearly with the number of bonds $n_{\text {bonds}}$}{figure.caption.19}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Trotter time at $\chi =50$ saturation vs.\ number of bonds for square grids $3\times 3$ through $8\times 8$, on MI100 (red) and MI60 (blue). Dashed lines are linear fits through the origin; the legend reports the per-bond slope. MI100 follows the linear model closely (slope $0.42$\,s/bond), confirming that gate cost is independent of grid size and total layer time is simply proportional to the number of bonds. MI60 departs from its linear fit at larger grids (slope $2.78$\,s/bond, but with increasing super-linear deviation), consistent with a growing Tensile cache-miss rate as the number of distinct GEMM shapes per layer increases with grid size.}}{20}{figure.caption.19}\protected@file@percent }
\newlabel{fig:grid_scaling}{{5}{20}{Trotter time at $\chi =50$ saturation vs.\ number of bonds for square grids $3\times 3$ through $8\times 8$, on MI100 (red) and MI60 (blue). Dashed lines are linear fits through the origin; the legend reports the per-bond slope. MI100 follows the linear model closely (slope $0.42$\,s/bond), confirming that gate cost is independent of grid size and total layer time is simply proportional to the number of bonds. MI60 departs from its linear fit at larger grids (slope $2.78$\,s/bond, but with increasing super-linear deviation), consistent with a growing Tensile cache-miss rate as the number of distinct GEMM shapes per layer increases with grid size}{figure.caption.19}{}}
