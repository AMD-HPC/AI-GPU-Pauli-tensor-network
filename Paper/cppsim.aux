\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Trap map: $C(t)$ at critical layers for $\chi \in \{50,\ldots  ,100\}$ on MI100 and MI60 (undamped), and MI100 with damped BP ($\alpha \in \{0.50, 0.80\}$). \textbf  {Bold}: trapped value ($C(t)\approx 0.007$--$0.010$). NCVG: non-convergent (100 sweeps, delta $> \epsilon _{\mathrm  {tol}}$). The reference value at $t=17$ is $\approx 0.066$ (MI60 undamped $\chi =80$; MI100 damped $\alpha =0.50$, $\chi =80$: $0.066$). }}{14}{figure.caption.13}\protected@file@percent }
\newlabel{tab:trap_map}{{3}{14}{Trap map: $C(t)$ at critical layers for $\chi \in \{50,\ldots ,100\}$ on MI100 and MI60 (undamped), and MI100 with damped BP ($\alpha \in \{0.50, 0.80\}$). \textbf {Bold}: trapped value ($\Ct \approx 0.007$--$0.010$). NCVG: non-convergent (100 sweeps, delta $> \epsilon _{\mathrm {tol}}$). The reference value at $t=17$ is $\approx 0.066$ (MI60 undamped $\chi =80$; MI100 damped $\alpha =0.50$, $\chi =80$: $0.066$)}{figure.caption.13}{}}
