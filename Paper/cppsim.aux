\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces FP32 compute efficiency (achieved TFLOPS / hardware peak TFLOPS, in percent) per Trotter layer for MI100 and MI60 at $4\times 4$, $\chi _{\mathrm  {max}}=100$. Both GPUs peak near $\chi _{\mathrm  {live}} \approx 49$ (layer~3), where matrix shapes are large enough for good GPU utilization but have not yet saturated the bond dimension. }}{23}{figure.caption.22}\protected@file@percent }
\newlabel{fig:efficiency}{{4}{23}{FP32 compute efficiency (achieved TFLOPS / hardware peak TFLOPS, in percent) per Trotter layer for MI100 and MI60 at $4\times 4$, $\chimax =100$. Both GPUs peak near $\chi _{\mathrm {live}} \approx 49$ (layer~3), where matrix shapes are large enough for good GPU utilization but have not yet saturated the bond dimension}{figure.caption.22}{}}
