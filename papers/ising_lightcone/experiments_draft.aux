\@writefile{toc}{\contentsline {paragraph}{Monotone convergence for clean runs.}{1}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces $C(t)$ on $4\times 4$, MI100, for $\chi \in \{20,\ldots  ,110\}$. \textbf  {Bold}: metastable BP trap ($C(t)\approx 0.007$--$0.009$), identified by elevated sweep count and inconsistency with neighboring layers. $^\dagger $: $\chi =20$ at $t=2.0$ is dominated by truncation error ($\text  {gate\_err} \approx 5\times 10^{-4}$); values above $t=1.5$ are an overestimate of the true $C(t)$. Clean runs form a monotone converging sequence in $\chi $ at every layer. }}{2}{}\protected@file@percent }
