\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Autocorrelation $C(t) = \langle Z_c(t) Z_c(0) \rangle $ for $\chi = 50, 100, 150, 200, 250, 300, 350, 400, 430$ over 30 Trotter steps at $\varepsilon =0.25$. The oscillatory behaviour is a genuine quantum recurrence of the XXX model on the finite heavy-hex graph. Curves for $\chi \geq 150$ are visually indistinguishable, indicating convergence.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:ct}{{2}{3}{Autocorrelation $C(t) = \langle Z_c(t) Z_c(0) \rangle $ for $\chi = 50, 100, 150, 200, 250, 300, 350, 400, 430$ over 30 Trotter steps at $\varepsilon =0.25$. The oscillatory behaviour is a genuine quantum recurrence of the XXX model on the finite heavy-hex graph. Curves for $\chi \geq 150$ are visually indistinguishable, indicating convergence}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Lightcone frontier analysis at $\chi =70$, cutoff $=10^{-3}$, $\varepsilon =0.10$, center site 13 (degree-3 junction, 3 hops from physical boundary). \emph  {Left}: maximum non-identity Pauli weight $n(v,t)$ per distance shell (BFS distance from site 13) vs Trotter cycle — the spreading wavefront is visible as a propagating bright ridge. \emph  {Right}: frontier distance (furthest active shell, threshold $10^{-4}$) vs cycle, with linear fit giving $v_{\rm  hop}=0.253$ hops/cycle (slope after one-step transient; fitted intercept $+1.65$ from initial spread to nearest neighbors at cycle 1). The frontier reaches the physical boundary (distance 3) by cycle $\sim $8; the faithful simulation regime is $\lesssim 12$ cycles.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:lightcone_frontier}{{3}{4}{Lightcone frontier analysis at $\chi =70$, cutoff $=10^{-3}$, $\varepsilon =0.10$, center site 13 (degree-3 junction, 3 hops from physical boundary). \emph {Left}: maximum non-identity Pauli weight $n(v,t)$ per distance shell (BFS distance from site 13) vs Trotter cycle — the spreading wavefront is visible as a propagating bright ridge. \emph {Right}: frontier distance (furthest active shell, threshold $10^{-4}$) vs cycle, with linear fit giving $v_{\rm hop}=0.253$ hops/cycle (slope after one-step transient; fitted intercept $+1.65$ from initial spread to nearest neighbors at cycle 1). The frontier reaches the physical boundary (distance 3) by cycle $\sim $8; the faithful simulation regime is $\lesssim 12$ cycles}{figure.3}{}}
