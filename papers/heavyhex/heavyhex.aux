\@writefile{toc}{\contentsline {paragraph}{Two-GPU pipeline and timing.}{9}{section*.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Per-cycle wall-clock times at $\chi _{\max }=250$, 10 cycles. $t_{\rm  cycle} = \max (t_{\rm  Trotter}, t_{\rm  IP})$. $t_{\rm  Trotter}$: GPU~0 Trotter time (4 states sequential). $t_{\rm  IP}$: GPU~1 wall-clock for all 9 inner products (parallel streams). Trotter dominates from cycle 3 — inner products add zero overhead.}}{9}{table.3}\protected@file@percent }
\newlabel{tab:timing}{{3}{9}{Per-cycle wall-clock times at $\chi _{\max }=250$, 10 cycles. $t_{\rm cycle} = \max (t_{\rm Trotter}, t_{\rm IP})$. $t_{\rm Trotter}$: GPU~0 Trotter time (4 states sequential). $t_{\rm IP}$: GPU~1 wall-clock for all 9 inner products (parallel streams). Trotter dominates from cycle 3 — inner products add zero overhead}{table.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Validation of inner product MPF.}{9}{section*.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \emph  {Left}: $|C(t)|$ at $\chi _{\max }=250$, 10 cycles, center site~13. Black: noiseless reference $|C_{\rm  nl}|$. Blue/red: noisy states $|C_{n,\gamma =1}|$ and $|C_{n,\gamma =2}|$ with shaded band. $\gamma =1$ decays slower than $C_{\rm  nl}$; $\gamma =2$ kills the quantum recurrence at cycle~5 and drops below $C_{\rm  nl}$, bracketing the ideal between the two noisy curves from cycle~5 onward — the MPF operates in a genuine interpolation regime, not extrapolation. Green: poor man's MPF. Blue curves: QR inner product MPF at $\delta =10^{-3}, 10^{-4}, 10^{-5}$. \emph  {Right}: wall-clock timing (symlog scale). Black lines: Trotter time per $\delta $ (grows with $\chi $). Blue curves: QR inner product wall-clock per $\delta $. At $\delta =10^{-3}$: IP hidden under Trotter throughout. At $\delta =10^{-5}$: IP dominates — inner products become the bottleneck. The operating point $\delta =10^{-3}$ balances accuracy and zero IP overhead.}}{10}{figure.5}\protected@file@percent }
\newlabel{fig:ip_timing}{{5}{10}{\emph {Left}: $|C(t)|$ at $\chi _{\max }=250$, 10 cycles, center site~13. Black: noiseless reference $|C_{\rm nl}|$. Blue/red: noisy states $|C_{n,\gamma =1}|$ and $|C_{n,\gamma =2}|$ with shaded band. $\gamma =1$ decays slower than $C_{\rm nl}$; $\gamma =2$ kills the quantum recurrence at cycle~5 and drops below $C_{\rm nl}$, bracketing the ideal between the two noisy curves from cycle~5 onward — the MPF operates in a genuine interpolation regime, not extrapolation. Green: poor man's MPF. Blue curves: QR inner product MPF at $\delta =10^{-3}, 10^{-4}, 10^{-5}$. \emph {Right}: wall-clock timing (symlog scale). Black lines: Trotter time per $\delta $ (grows with $\chi $). Blue curves: QR inner product wall-clock per $\delta $. At $\delta =10^{-3}$: IP hidden under Trotter throughout. At $\delta =10^{-5}$: IP dominates — inner products become the bottleneck. The operating point $\delta =10^{-3}$ balances accuracy and zero IP overhead}{figure.5}{}}
