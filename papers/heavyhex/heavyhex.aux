\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Lightcone frontier velocity $v_{\rm  hop}$ sweep over $(\chi _{\max }, \delta )$ for the \texttt  {heavy\_hex\_3x3} graph, center site 13, $\varepsilon =0.10$, $J=1$, 20 cycles. Velocity converges to $v_{\rm  hop} = 0.253\pm 0.002$ hops/cycle across all $(\chi _{\max }, \delta )$ combinations, confirming that $\chi =70$, $\delta ^*=10^{-3}$ is the faithful operating point and that $\chi $ is not the bottleneck.}}{5}{table.1}\protected@file@percent }
\newlabel{tab:lightcone}{{1}{5}{Lightcone frontier velocity $v_{\rm hop}$ sweep over $(\chi _{\max }, \delta )$ for the \texttt {heavy\_hex\_3x3} graph, center site 13, $\varepsilon =0.10$, $J=1$, 20 cycles. Velocity converges to $v_{\rm hop} = 0.253\pm 0.002$ hops/cycle across all $(\chi _{\max }, \delta )$ combinations, confirming that $\chi =70$, $\delta ^*=10^{-3}$ is the faithful operating point and that $\chi $ is not the bottleneck}{table.1}{}}
